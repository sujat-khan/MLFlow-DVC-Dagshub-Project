# Data & Models (let DVC track datasets/models while keeping folders & .dvc files in git)
/data/*
!/data/raw/
!/data/processed/
!/data/interim/
!/data/external/
!/data/**/.gitkeep
!/data/**/*.dvc

/models/*
!/models/.gitkeep
!/models/**/*.dvc
